# echo — 環境変数テンプレート（キー名のみ・値は書かない）
# 実際の値は各自 .env.local（gitignore 済み）や Vercel の環境変数に設定する。

# --- Supabase（新キー命名） ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- LINE ログイン（Login チャネル 2010386860） ---
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# --- LINE 通知（Messaging API チャネル 2010599784・Login と同一プロバイダー「エコー」） ---
# ログイン用（LINE_CHANNEL_*）とは別チャネル。上書きしないこと。userId は両チャネルで一致。
# このスライス(2)で実際に使うのは _SECRET（webhook署名検証）のみ。
# _ACCESS_TOKEN は push 送信用（後続スライス）だが、Vercel 投入を一度で済ませるためここに含める。
LINE_MESSAGING_CHANNEL_ID=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# --- LINE 公式アカウント 友だち追加URL（/staff の友だち追加カード導線・任意） ---
# echo公式アカウントの友だち追加URL（Basic ID の https://line.me/R/ti/p/@xxxx か lin.ee/xxxx）。
# クライアントに露出してよい公開値のため NEXT_PUBLIC_。サロン共通の1本。
# 未設定なら /staff の友だち追加カードは表示しない（安全側）。値は .env.local / Vercel に各自設定。
NEXT_PUBLIC_LINE_ADD_FRIEND_URL=

# --- アプリ / セッション ---
APP_BASE_URL=
SESSION_SECRET=

# --- Cron（来店リマインド通知ワーカー /api/cron/line-push） ---
# Vercel Cron が Authorization: Bearer <CRON_SECRET> を自動付与する。route 側で照合。
# 32byte 以上の乱数を各自生成（例: openssl rand -hex 32）。このファイルに実値は書かない。
CRON_SECRET=

# --- Stripe（評価スタンプ購入・Direct Charge） ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- 営業デモ用ログインバイパス（本番Prodには設定しない＝常に404） ---
# DEMO_LOGIN_ENABLED: "true" のときだけ /demo と /api/demo/login が有効。
#   本番Prod env には置かない。Preview 環境変数にのみ設定する。
# DEMO_LOGIN_SECRET: 32byte 以上の乱数を各自で生成して設定（例: openssl rand -hex 32）。
#   このファイルにサンプル値・実値を絶対に書かないこと。
DEMO_LOGIN_ENABLED=
DEMO_LOGIN_SECRET=
